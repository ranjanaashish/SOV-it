# Copy to .env and export, or set in your shell / container. Never commit real keys.
# All values are optional.

# OpenAI-compatible endpoint: Ollama (default), vLLM, llama.cpp server, LocalAI, TGI
LLM_BASE_URL=http://localhost:11434/v1
# Any instruct model, e.g. qwen2.5:7b-instruct, llama3.1:8b-instruct, mistral-nemo, qwen2.5:14b-instruct
LLM_MODEL=qwen2.5:7b-instruct
# Only if your gateway needs one
LLM_API_KEY=
# 1 = rules-only mode (no LLM calls at all)
LLM_DISABLED=0
# 0 = send only headers to the LLM, never cell values
LLM_SEND_SAMPLES=1
LLM_TIMEOUT=45
# Parallel LLM requests for batched explanations
LLM_MAX_WORKERS=4
# Ollama only: keep the model loaded between calls
LLM_KEEP_ALIVE=30m

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DISABLED=0

KG_PATH=data/knowledge_graph.json
